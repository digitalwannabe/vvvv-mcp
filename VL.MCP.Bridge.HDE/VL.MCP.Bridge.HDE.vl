  <ProjectDependency Id="dHUBN5wPo7hFQlE5PvHtsE" Location="src/VL.MCP.Bridge.csproj" />
  <Patch Id="uZy2prGT79N71qNIgMLVzJ">
    <Canvas Id="CszKXMsBcsMYX4NUQFIV9h" DefaultCategory="HDE" CanvasType="FullCategory" />
    <!--

    ************************ Application ************************

-->
    <Node Name="Application" Bounds="100,100" Id="2TuXrHP5hWPlXGDeT3k6hf">
      <p:NodeReference>
        <Choice Kind="ContainerDefinition" Name="Process" />
        <FullNameCategoryReference ID="Primitive" />
      </p:NodeReference>
      <Patch Id="udSS4M5GMdJf0fa9ekwhK0">
        <Canvas Id="JwhHRwwPuCAWjRFZMC9bJw" CanvasType="Group">

          <!-- Info comment -->
          <Pad Id="Q4RbowS8YyAtzy7QIKf0FO" Bounds="269,180,380,50" ShowValueBox="true" isIOBox="true" Value="MCP Bridge Server&#xD;&#xA;Connects this vvvv instance to the vvvv-mcp AI tool server.&#xD;&#xA;Listens on localhost:7123 for MCP requests.">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>

          <!-- Port IOBox -->
          <Pad Id="Joa7iM4Xy2uiDzdqQ5FekZ" Comment="Port" Bounds="271,280,50,15" ShowValueBox="true" isIOBox="true" Value="7123">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="Integer32" />
            </p:TypeAnnotation>
          </Pad>

          <!-- Enabled toggle -->
          <Pad Id="sWjFdy3L0GpMoMfCOBE3bC" Comment="Enabled" Bounds="341,280,35,15" ShowValueBox="true" isIOBox="true" Value="True">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="Boolean" />
              <FullNameCategoryReference ID="Primitive" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:buttonmode p:Assembly="VL.UI.Forms" p:Type="VL.HDE.PatchEditor.Editors.ButtonModeEnum">Toggle</p:buttonmode>
            </p:ValueBoxSettings>
          </Pad>

          <!-- MCPBridgeServer process node -->
          <Node Bounds="269,320,150,26" Id="H1STrDzpzt9uoNxzBmxf0v">
            <p:NodeReference LastCategoryFullName="MCP.Bridge" LastDependency="VL.MCP.Bridge.csproj">
              <Choice Kind="NodeFlag" Name="Node" Fixed="true" />
              <Choice Kind="ProcessAppFlag" Name="MCPBridgeServer" />
            </p:NodeReference>
            <Pin Id="6DzM85foTXVM1byzHAtcny" Name="Node Context" Kind="InputPin" IsHidden="true" />
            <Pin Id="aqVJtn5vblPW4PdeE4JKal" Name="Port" Kind="InputPin" />
            <Pin Id="YbVVALfwwYIHmJ1yL1sh5u" Name="Enabled" Kind="InputPin" />
            <Pin Id="7fgjVm5zScYzS4yXnuQpz0" Name="Port" Kind="OutputPin" />
            <Pin Id="OxmUnQsSc2pod0zaz206Gp" Name="Is Running" Kind="OutputPin" />
            <Pin Id="tx06AxN8RQ5GQt7B9pG99g" Name="Last Error" Kind="OutputPin" />
          </Node>

          <!-- Status display: Is Running -->
          <Pad Id="WspIhSYL4f5t5EYcsFenCn" Comment="Is Running" Bounds="271,380,50,15" ShowValueBox="true" isIOBox="true" Value="">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="Boolean" />
            </p:TypeAnnotation>
          </Pad>

          <!-- Status display: Last Error -->
          <Pad Id="21KRKNqDZr8q91aVRkwoMK" Comment="Last Error" Bounds="341,380,250,15" ShowValueBox="true" isIOBox="true" Value="">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="CoreLibBasics.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
          </Pad>

        </Canvas>
        <Patch Id="b1PhDTYAK9V4Ugvx4JU7sG" Name="Create" />
        <Patch Id="fe6J4FXthtqWUp1usc1u2A" Name="Update" />
        <ProcessDefinition Id="Bp6jnZIzGMDVWvk3YSnabl">
