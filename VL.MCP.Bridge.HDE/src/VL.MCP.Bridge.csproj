<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <RootNamespace>VL.MCP.Bridge</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- VL.Core gives us [ProcessNode], NodeContext, AppHost, etc. -->
    <PackageReference Include="VL.Core" Version="2025.7.1-*" />
  </ItemGroup>

  <!-- ASP.NET Core is already loaded in the vvvv process; we reference the shared framework -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="VL.Core" />
    <Using Include="VL.Core.Import" />
  </ItemGroup>

</Project>
