<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- dotnet global tool -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>vvvv-mcp</ToolCommandName>
    <!-- NuGet package metadata -->
    <PackageId>vvvv-mcp</PackageId>
    <Version>1.0.0</Version>
    <Title>vvvv-mcp</Title>
    <Description>MCP server for vvvv gamma. Search 6400+ nodes, read/write .vl patches, generate C# nodes and SDSL shaders, access the full Gray Book knowledge base, and connect to a live running vvvv instance via the VL.MCP.HDE editor extension. Works without a vvvv installation for all knowledge and patch tools.</Description>
    <Authors>digital.wannabe</Authors>
    <PackageTags>vvvv;vvvv-gamma;mcp;modelcontextprotocol;ai;agent;visual-programming</PackageTags>
    <PackageProjectUrl>https://github.com/digitalwannabe/mcp-gamma-server</PackageProjectUrl>
    <RepositoryUrl>https://github.com/digitalwannabe/mcp-gamma-server</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Copyright>digital.wannabe</Copyright>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="0.*" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.*" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="8.*" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\VvvvMcp.Core\VvvvMcp.Core.csproj" />
  </ItemGroup>
  <!--
    Bundle the node catalog and knowledge files.
    CopyToOutputDirectory copies them into bin/Release/net8.0/; for PackAsTool,
    dotnet pack automatically includes the entire build output in tools/net8.0/any/,
    so no separate Pack="true" items are needed (which would cause duplicate-file errors).
  -->
  <ItemGroup>
    <None Include="..\..\VVVVNodeAnalyzer\output\vvvv_nodes_mcp.json" CopyToOutputDirectory="PreserveNewest" Link="vvvv_nodes_mcp.json" />
    <None Include="..\..\knowledge\*.md" CopyToOutputDirectory="PreserveNewest" Link="knowledge\%(Filename)%(Extension)" />
    <!-- Template files â€” copied recursively into knowledge/templates/ in the output -->
    <None Include="..\..\knowledge\templates\**\*" CopyToOutputDirectory="PreserveNewest" Link="knowledge\templates\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <!-- README for NuGet package page -->
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>