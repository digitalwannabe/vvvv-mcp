  <!--
    Bundle the node catalog and knowledge files.
    CopyToOutputDirectory copies them into bin/Release/net8.0/; for PackAsTool,
    dotnet pack automatically includes the entire build output in tools/net8.0/any/,
    so no separate Pack="true" items are needed (which would cause duplicate-file errors).
  -->
  <ItemGroup>
    <None Include="..\..\VVVVNodeAnalyzer\output\vvvv_nodes_mcp.json" CopyToOutputDirectory="PreserveNewest" Link="vvvv_nodes_mcp.json" />
    <None Include="..\..\knowledge\*.md" CopyToOutputDirectory="PreserveNewest" Link="knowledge\%(Filename)%(Extension)" />
    <!-- Template files â€” copied recursively into knowledge/templates/ in the output -->
    <None Include="..\..\knowledge\templates\**\*" CopyToOutputDirectory="PreserveNewest" Link="knowledge\templates\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <!-- README for NuGet package page -->
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
